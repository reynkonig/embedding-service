EMBEDDING_API_KEY=replace-with-a-long-random-secret

EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSIONS=384
EMBEDDING_BACKEND=mean
EMBEDDING_TRUST_REMOTE_CODE=false

# One model replica per device.
EMBEDDING_DEVICES=cuda:0

# Shard one model across all visible GPUs instead.
# EMBEDDING_DEVICES=auto
# EMBEDDING_DEVICE_MAP=auto

EMBEDDING_DTYPE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=256
EMBEDDING_ATTN_IMPLEMENTATION=auto
EMBEDDING_PRELOAD=false

EMBEDDING_BIND_ADDRESS=127.0.0.1
EMBEDDING_PUBLISHED_PORT=8091
